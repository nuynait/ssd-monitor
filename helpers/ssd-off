#!/bin/bash
# ssd-off: run before unplugging the external SSD on purpose.
#   ssd-off           stop dev services, flush, unmount all SSD volumes, eject the SSD
#   ssd-off --check   only show what is using the SSD, change nothing
#   ssd-off -y        don't ask before unmounting
#   ssd-off --step NAME   one step, for the SSD Monitor app. Prints one tab-separated line per result;
#                         exit 1 means the step failed. Nothing is stopped for you in step mode.
#     unmount   plain unmount of every mounted SSD volume: UNMOUNTED or BUSY lines
#     users     USER cmd pid kind path: what has files open on the SSD (kind: cwd, file, or system for
#               macOS services); FAILED if lsof gave no list, WARN if the list may be incomplete
#     force     force-unmount every SSD volume still mounted (programs using them lose those files)
#     eject     eject the SSD once nothing on it is mounted
#     mark      leave the planned-unplug marker, so the app does not sound the alarm
# ssd-monitor-protocol: 1   (SSD Monitor runs only scripts that carry this line)
# Claude Code / Codex sessions and shells in ~/Repo can stay open: they show errors until the SSD
# is back and ssd-resume has run. Make sure none of them is in the middle of writing files.
set -u
HERE=$(cd "$(dirname "$0")" && pwd -P)
. "$HERE/ssd-volumes.sh"
CHECK=0; YES=0; STEP=""
while [ $# -gt 0 ]; do
  case $1 in
    --check) CHECK=1 ;;
    -y|--yes) YES=1 ;;
    --step) [ -n "${2:-}" ] || { echo "--step needs a value" >&2; exit 2; }; STEP=$2; shift ;;
    *) echo "unknown option: $1" >&2; exit 2 ;;
  esac
  shift
done
say() { printf '%s\n' "$*"; }
emit() { local kind=$1 IFS=$'\t'; shift; printf '%s\t%s\n' "$kind" "$*"; }
# The marker tells SSD Monitor that the SSD goes away on purpose. ssd-resume's record step removes it.
MARKER=$SSD_STATE_DIR/planned-unplug
mark_planned() { mkdir -p "$SSD_STATE_DIR" && date +%s > "$MARKER"; }

# Once the marker is written (MARKED=1), an exit before the eject removes it again, also on Ctrl-C or a stop
# from SSD Monitor: the SSD is not going away after all.
MARKED=0
on_exit() { if [ $MARKED = 1 ]; then rm -f "$MARKER"; fi; return 0; }
trap on_exit EXIT
trap 'exit 130' INT TERM HUP

# The SSD, found through any of its volumes that is attached, and the disks it lives on. Only the eject and
# the terminal run need this (diskutil takes a moment per question), so it is looked up there.
find_ssd() {
  local any_uuid info
  dev=""; container=""; whole=""
  ssd_load_devices
  any_uuid=$(ssd_any_uuid)
  [ -n "$any_uuid" ] || return 0
  info=$(diskutil info "$any_uuid")
  dev=$(printf '%s\n' "$info" | awk -F': *' '/Device Node/ {print $2; exit}')
  container=$(printf '%s\n' "$info" | awk -F': *' '/Part of Whole/ {print $2; exit}')
  store=$(printf '%s\n' "$info" | awk -F': *' '/APFS Physical Store/ {print $2; exit}')
  whole=${store%s[0-9]*}
}

# Unmount each mounted SSD volume. $1: "" for a plain unmount, "force" to force it. Returns 1 if any stays mounted.
unmount_each() {
  local mode=${1:-} bad=0 entry name uuid want vdev msg
  ssd_snapshot_mounts
  for entry in "${SSD_VOLUMES[@]}"; do
    ssd_split "$entry"; name=$V_NAME; uuid=$V_UUID; want=$V_PATH
    ssd_dev "$uuid"; vdev=$DEV; [ -n "$vdev" ] || continue
    ssd_snap_of "$vdev" || continue
    if msg=$(diskutil unmount $mode "$vdev" 2>&1); then emit UNMOUNTED "$name"
    else emit BUSY "$name" "${msg##*$'\n'}"; bad=1; fi
  done
  return $bad
}

# Where the SSD's volumes are: their own paths, plus wherever one is mounted instead (e.g. /Volumes/Repo).
ssd_roots() {
  local e name uuid want vdev
  ssd_snapshot_mounts
  for e in "${SSD_VOLUMES[@]}"; do
    ssd_split "$e"; name=$V_NAME; uuid=$V_UUID; want=$V_PATH
    printf '%s|' "$want"
    ssd_dev "$uuid"; vdev=$DEV; [ -n "$vdev" ] || continue
    if ssd_snap_of "$vdev" && [ "$SNAP_AT" != "$want" ]; then printf '%s|' "$SNAP_AT"; fi
  done
}

# Files open on the SSD, one line per program and kind: cmd pid cwd|file|system example-path (at most 60).
# Returns 1 if lsof gave no list at all, 2 if it reported errors (the list may be incomplete, e.g. on a
# failing disk). lsof's listing streams through the filter (it is the whole Mac's open files); awk reads it all,
# so lsof always finishes and its exit status is real.
users_on_ssd() {
  local roots out rc
  roots=$(ssd_roots)
  out=$(lsof -nP +c0 -Fpcfn 2>/dev/null | awk -v roots="$roots" '
    BEGIN { n = split(roots, r, "|") }
    /^p/ { pid = substr($0, 2) } /^c/ { cmd = substr($0, 2) } /^f/ { fd = substr($0, 2) }
    /^n/ { path = substr($0, 2); for (i = 1; i <= n; i++) if (r[i] != "" && (path == r[i] || index(path, r[i] "/") == 1)) {
             if (cmd ~ /^(lsof|awk)$/) break
             # macOS services (Spotlight, fseventsd) are listed too, as "system": they usually let go by themselves.
             kind = (cmd ~ /^(mds.*|mdworker.*|fseventsd)$/ ? "system" : (fd == "cwd" ? "cwd" : "file")); key = pid SUBSEP kind
             if (!(key in seen) && shown < 60) { seen[key] = 1; shown++; print cmd "\t" pid "\t" kind "\t" path }
             break } }
    END { print "#lines\t" NR }'; exit "${PIPESTATUS[0]}"); rc=$?
  # The last line counts what lsof gave: nothing at all means no list.
  case ${out##*$'\n'} in "#lines"$'\t'0|"") return 1 ;; esac
  [ $rc -gt 1 ] && return 1
  case $out in *$'\n'*) printf '%s\n' "${out%$'\n'*}" ;; esac
  [ $rc = 0 ] || return 2
}

# ---- one step for the SSD Monitor app
if [ -n "$STEP" ]; then
  case $STEP in
    unmount) unmount_each "" ;;
    force) unmount_each force ;;
    users)
      raw=$(users_on_ssd); rc=$?
      if [ $rc = 1 ]; then emit FAILED "lsof could not list the open files"; exit 1; fi
      [ $rc = 2 ] && emit WARN "lsof reported errors; the list may be incomplete"
      if [ -n "$raw" ]; then
        while IFS=$'\t' read -r c p k d; do emit USER "$c" "$p" "$k" "$d"; done <<< "$raw"
      fi
      exit 0 ;;
    eject)
      find_ssd
      if [ -z "$dev" ]; then
        # Not found: make sure that means "not attached", not "diskutil failed" with volumes still mounted.
        # (One read of the mount table for all seven paths.)
        ssd_snapshot_mounts
        for e in "${SSD_VOLUMES[@]}"; do
          p=${e##*|}
          for l in ${SSD_MOUNT_LINES[@]+"${SSD_MOUNT_LINES[@]}"}; do
            case $l in *" on $p ("*) emit FAILED "$p is still mounted, but diskutil can't find the SSD"; exit 1 ;; esac
          done
        done
        emit EJECTED "not attached"; exit 0
      fi
      if msg=$(diskutil eject "$whole" 2>&1); then emit EJECTED "$whole"; else emit FAILED "${msg##*$'\n'}"; exit 1; fi ;;
    mark) mark_planned ;;
    *) echo "unknown step: $STEP" >&2; exit 2 ;;
  esac
  exit $?
fi

find_ssd
[ -z "$dev" ] && { say "SSD is not attached. Nothing to do."; exit 0; }

# GUI apps can lose unsaved work if their files vanish: they must be quit by hand.
apps=()
pgrep -x Xcode >/dev/null && apps+=("Xcode")
pgrep -x Simulator >/dev/null && apps+=("Simulator")
pgrep -f 'Android Studio.app/Contents/MacOS' >/dev/null && apps+=("Android Studio")
if [ ${#apps[@]} -gt 0 ]; then
  say "Quit first: ${apps[*]}"
  [ $CHECK = 1 ] || exit 1
fi

# What has files open on the SSD (agents and shells only hold their working folder; that is fine).
raw=$(users_on_ssd); rc=$?
users=$(printf '%s' "$raw" | awk -F'\t' 'NF { print "  " $1 " (pid " $2 ")" ($3 == "cwd" ? " — working folder" : $3 == "system" ? " — macOS service, usually lets go by itself" : " — open file") }' | head -25)
if [ $rc = 1 ]; then say "Could not list what uses the SSD (lsof failed)."
elif [ -n "$users" ]; then say "Using the SSD now:"; say "$users"
else say "Nothing is using the SSD."; fi
[ $rc = 2 ] && say "(lsof reported errors; the list may be incomplete)"
[ $CHECK = 1 ] && exit 0

if [ $YES = 0 ]; then
  printf 'Stop dev services and unmount the SSD now? [y/N] '; read -r ans
  [ "$ans" = y ] || [ "$ans" = Y ] || { say "Cancelled."; exit 1; }
fi
# Without the marker SSD Monitor would sound the alarm for this unplug: stop before anything is touched.
mark_planned || { say "Could not write $MARKER. Nothing was stopped or unmounted."; exit 1; }
MARKED=1   # interrupted or failed before the eject: the exit handler removes the marker again

# Stop the background dev services that keep files open on the SSD.
if pgrep -f CoreSimulatorService >/dev/null; then
  xcrun simctl shutdown all >/dev/null 2>&1; killall -TERM com.apple.CoreSimulator.CoreSimulatorService 2>/dev/null
  say "  ■ simulators shut down"
fi
ADB=$HOME/Library/Android/sdk/platform-tools/adb
if pgrep -x adb >/dev/null || pgrep -f qemu-system >/dev/null; then
  for e in $("$ADB" devices 2>/dev/null | awk '/^emulator-/ {print $1}'); do "$ADB" -s "$e" emu kill >/dev/null 2>&1; done
  "$ADB" kill-server >/dev/null 2>&1 || pkill -x adb
  say "  ■ emulators and adb stopped"
fi
if pgrep -f 'GradleDaemon|KotlinCompileDaemon' >/dev/null; then
  pkill -f 'GradleDaemon|KotlinCompileDaemon'; say "  ■ Gradle/Kotlin daemons stopped"
fi
sleep 2; sync

# Unmount every volume in the SSD's container (forced: shells and agents keep a working folder there), then eject.
if diskutil unmountDisk force "$container" >/dev/null 2>&1 && diskutil eject "$whole" >/dev/null 2>&1; then
  MARKED=0   # going away on purpose: the marker stays for SSD Monitor
  # "ejected" confirms the unplug happened: SSD Monitor then honours the marker however old it is (e.g. after a
  # restart while the SSD is away). A marker without it counts for 10 minutes only (an ssd-off killed halfway).
  printf 'ejected\n' >> "$MARKER"
  say "Safe to unplug the SSD."
  say "Sessions and shells in SSD folders will show errors until you plug it back in and run ssd-resume."
else
  # Not going away after all: the exit trap removes the marker, so SSD Monitor alarms about what is left unmounted.
  say "Unmount or eject failed. Check 'diskutil list $whole' and try again; do not unplug yet."; exit 1
fi
